# Dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Build output
dist/
build/
.next/
out/
*.tsbuildinfo
next-env.d.ts

# Environment secrets — NEVER commit real secrets.
# .env.example templates ARE kept as reference.
.env
.env.*
!.env.example
.env.backup*
.env.render
render.env

# Server: locally-stored image uploads (disk-storage mode)
bichitrapoint_Server/uploads/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Testing / coverage
/coverage
coverage/

# Deploy / platform
.vercel

# Large local binaries / artwork (kept locally, not in repo)
*.exe
*.msi
*.zip
*.dmg
*.pem

# Editor / OS / misc
.DS_Store
.claude/
branch_structure.json
temp_auto_push.bat
